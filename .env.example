BOT_TOKEN=put_your_botfather_token_here
API_URL=https://chikuu-bot-yi71.vercel.app

# one MongoDB link per variable (1 to 5). Leave unused ones out.
MONGO_URI_1=mongodb+srv://user:password@cluster1.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI_2=
MONGO_URI_3=

# Stickers: pack name or t.me/addstickers/NAME link (several packs separated by commas).
# Every 3-5 replies the bot gets a chance (STICKER_CHANCE) to send one.
STICKER_PACK=
STICKER_CHANCE=0.6
# optional per-mood packs (used when the API reports that mood): STICKER_HAPPY STICKER_ANGRY STICKER_SLEEPY STICKER_SAD STICKER_LOVE

# Voice notes (female voice). VOICE_GAP = minimum replies between two random voice notes.
VOICE_NAME=hi-IN-SwaraNeural
VOICE_CHANCE=0.15
VOICE_GAP=10
# VOICE_ENGINE=edge (default, free) or gemini (needs the /tts endpoint in the API). VOICE_ENABLED=0 turns voice off.
